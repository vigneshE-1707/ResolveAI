# ResolveAI — Environment variables (.env.example)
# Copy to .env and fill in. NEVER commit real secrets.
# APP_ENV=development | production

# ─── General ───────────────────────────────────────────────
APP_ENV=development
APP_NAME=ResolveAI
LOG_LEVEL=INFO
LOG_FORMAT=text                      # text | json (json in prod)
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_PORT=8000

# ─── Database (local dev: Postgres 16 + pgvector) ─────────
DATABASE_URL=postgresql+asyncpg://resolveai:resolveai@localhost:5432/resolveai
# Supabase (prod): or via Supabase pooler (session mode recommended for checkpointer):
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_POOL_SIZE=10
DB_STATEMENT_TIMEOUT_MS=15000

# ─── Security / Auth ───────────────────────────────────────
JWT_SECRET_KEY=change-me-32+chars-random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false                  # true in prod (HTTPS)
ACTOR_TOKEN_TTL_SECONDS=60           # MCP-scoped actor JWT lifetime

# ─── AI / LLM ──────────────────────────────────────────────
LLM_PROVIDER=google_genai            # provider abstraction; e.g. openai later
LLM_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30
AGENT_MAX_STEPS=4                    # max tool iterations per turn
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
KNOWLEDGE_TOP_K=4

# ─── MCP ───────────────────────────────────────────────────
MCP_SERVER_URL=http://127.0.0.1:8100/mcp
MCP_PORT=8100
MCP_CALL_TIMEOUT_SECONDS=10
MCP_AUDIENCE=business-tools          # expected `aud` in actor JWT

# ─── LangSmith (optional in dev) ───────────────────────────
LANGSMITH_TRACING=false              # true only if key present
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=resolveai-development
LANGSMITH_CONTENT_CAPTURE=false      # keep customer text out of traces

# ─── Frontend (Vite: VITE_* prefix) ────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MODE=demo                       # demo | live (demo uses frontend/src/mocks)
